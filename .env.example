# Database Configuration
POSTGRES_DB=occueye_db
POSTGRES_USER=occueye_user
POSTGRES_PASSWORD=occueye_password

# Camera & Classroom
CAMERA_SOURCE=0
CLASSROOM_ID=room_101

# Student Detection (Local YOLO)
STUDENT_MODEL_PATH=yolov8n.pt
CONF_THRESHOLD=0.50

# Fan Detection (Roboflow Hosted Model)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_API_URL=https://serverless.roboflow.com
FAN_MODEL_ID=ceiling-fan-detection-epfsk/1
FAN_CONFIDENCE_THRESHOLD=0.45

# Timing & Stabilization
FAN_CHECK_INTERVAL_SECONDS=0.5
FAN_INFERENCE_TIMEOUT_SECONDS=5.0
FAN_STALE_TIMEOUT_SECONDS=6.0
FAN_STABILIZATION_COUNT=2

# Alert Threshold & Storage
IDLE_TIME_THRESHOLD=10
SNAPSHOT_DIR=snapshots